          "openai_alias": "E-li-as Kor-pe-la",
          "instruction": "Lausu Elias Korpela suomalaisittain: E-li-as Kor-pe-la. Molemmissa nimissä paino on ensimmäisellä tavulla. Älä venytä Eliaksen keskimmäistä tavua.",
          "openai_force_alias": "E-li-ass Kor-pe-la"
        },
        "en-GB": {
          "ipa": "ˈeliɑs ˈkorpelɑ",
          "spoken": "Elias Korpela",
          "openai_alias": "EH-li-as KOR-pe-la",
          "instruction": "Pronounce Elias Korpela as Finnish: EH-li-as KOR-pe-la. Elias has three short syllables, stress on EH, and the middle syllable must not be stretched. Korpela has stress on KOR, with a clear r and short 'pe' and 'la'. Do not anglicise either name.",
          "openai_force_alias": "EH-li-ass KOR-pe-la"
        },
        "en-US": {
          "ipa": "ˈeliɑs ˈkorpelɑ",
          "spoken": "Elias Korpela",
          "openai_alias": "EH-li-as KOR-pe-la",
          "instruction": "Pronounce Elias Korpela as Finnish: EH-li-as KOR-pe-la. Elias has three short syllables, stress on EH, and the middle syllable must not be stretched. Korpela has stress on KOR, with a clear r and short 'pe' and 'la'. Do not anglicise either name.",
          "openai_force_alias": "EH-li-ass KOR-pe-la"
        },
        "es-MX": {
          "ipa": "ˈeliɑs ˈkorpelɑ",
